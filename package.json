{
  "name": "filex-editor",
  "version": "0.1.1",
  "description": "A Bangla-first terminal text editor with atomic saves and grapheme-correct editing",
  "keywords": [
    "editor",
    "text-editor",
    "terminal",
    "tui",
    "cli",
    "bangla",
    "bengali",
    "unicode",
    "bun",
    "opentui"
  ],
  "homepage": "https://github.com/dev-sajid007/filex#readme",
  "bugs": {
    "url": "https://github.com/dev-sajid007/filex/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dev-sajid007/filex.git"
  },
  "license": "MIT",
  "author": "dev-sajid007 (https://github.com/dev-sajid007)",
  "type": "module",
  "bin": {
    "filex": "dist/filex.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.bn.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run --watch src/index.tsx",
    "start": "bun run src/index.tsx",
    "build": "rm -rf dist && bun build src/index.tsx --target bun --outfile dist/filex.js --packages external",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@opentui/core": "0.6.6",
    "@opentui/react": "0.6.6",
    "react": "19.3.1"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
