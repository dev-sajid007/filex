    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@opentui/core": "0.6.6",
    "@opentui/react": "0.6.6",
    "react": "19.3.1"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
