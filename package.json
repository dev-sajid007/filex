{
  "name": "filex",
  "version": "0.0.1",
  "description": "A Bangla-first terminal file editor",
  "module": "src/index.tsx",
  "type": "module",
  "private": true,
  "bin": {
    "filex": "src/index.tsx"
  },
  "scripts": {
